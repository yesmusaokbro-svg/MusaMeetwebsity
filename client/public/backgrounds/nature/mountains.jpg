<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="mtSky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1976D2;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#42A5F5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#81D4FA;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="1920" height="1080" fill="url(#mtSky)"/>
  
  <!-- Sun -->
  <circle cx="1700" cy="180" r="70" fill="#FFF9C4"/>
  
  <!-- Distant mountains -->
  <polygon points="0,700 400,400 800,700" fill="#546E7A" opacity="0.6"/>
  <polygon points="600,700 1100,350 1600,700" fill="#607D8B" opacity="0.6"/>
  <polygon points="1300,700 1750,300 2200,700" fill="#546E7A" opacity="0.6"/>
  
  <!-- Main mountains with snow -->
  <polygon points="0,850 500,250 1000,850" fill="#37474F"/>
  <polygon points="500,250 400,400 600,400" fill="#ECEFF1"/>
  
  <polygon points="700,850 1200,150 1700,850" fill="#455A64"/>
  <polygon points="1200,150 1100,350 1300,350" fill="#FAFAFA"/>
  
  <polygon points="1400,850 1850,300 2300,850" fill="#37474F"/>
  <polygon points="1850,300 1750,450 1950,450" fill="#ECEFF1"/>
  
  <!-- Foreground grass -->
  <ellipse cx="960" cy="1000" rx="1000" ry="150" fill="#2E7D32" opacity="0.8"/>
  <rect y="1000" width="1920" height="80" fill="#1B5E20" opacity="0.8"/>
  
  <text x="960" y="1000" font-family="Arial, sans-serif" font-size="70" fill="#37474F" opacity="0.15" text-anchor="middle" font-weight="bold">MOUNTAIN VISTA</text>
</svg>
