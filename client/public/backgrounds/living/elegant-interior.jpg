<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="elegantWall" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#D7CCC8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#BCAAA4;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Elegant wall -->
  <rect width="1920" height="1080" fill="url(#elegantWall)"/>
  
  <!-- Crown molding -->
  <rect y="0" width="1920" height="80" fill="#A1887F" opacity="0.5"/>
  <rect y="70" width="1920" height="10" fill="#8D6E63"/>
  
  <!-- Wainscoting panels -->
  <rect x="150" y="300" width="350" height="500" fill="#EFEBE9" opacity="0.7"/>
  <rect x="550" y="300" width="350" height="500" fill="#D7CCC8" opacity="0.7"/>
  <rect x="950" y="300" width="350" height="500" fill="#EFEBE9" opacity="0.7"/>
  <rect x="1350" y="300" width="350" height="500" fill="#D7CCC8" opacity="0.7"/>
  
  <!-- Picture frame -->
  <rect x="700" y="150" width="520" height="400" fill="#6D4C41" opacity="0.8"/>
  <rect x="730" y="180" width="460" height="340" fill="#8D6E63"/>
  <ellipse cx="960" cy="350" rx="150" ry="120" fill="#A1887F" opacity="0.5"/>
  
  <!-- Chandelier suggestion -->
  <circle cx="960" cy="150" r="60" fill="#FFC107" opacity="0.4"/>
  <circle cx="920" cy="180" r="20" fill="#FDD835" opacity="0.6"/>
  <circle cx="1000" cy="180" r="20" fill="#FDD835" opacity="0.6"/>
  
  <!-- Floor -->
  <rect y="900" width="1920" height="180" fill="#8D6E63"/>
  
  <!-- Furniture silhouette -->
  <ellipse cx="960" cy="900" rx="400" ry="50" fill="#6D4C41" opacity="0.5"/>
  
  <text x="960" y="1000" font-family="Georgia, serif" font-size="60" fill="#8D6E63" opacity="0.2" text-anchor="middle" font-style="italic" font-weight="bold">Elegant Interior</text>
</svg>
