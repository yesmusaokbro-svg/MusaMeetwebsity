<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="classWall" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ECEFF1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#CFD8DC;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Wall -->
  <rect width="1920" height="1080" fill="url(#classWall)"/>
  
  <!-- Whiteboard -->
  <rect x="400" y="150" width="1120" height="500" fill="#FFFFFF"/>
  <rect x="380" y="130" width="1160" height="540" fill="none" stroke="#90A4AE" stroke-width="20"/>
  
  <!-- Writing on board -->
  <text x="960" y="300" font-family="Arial, sans-serif" font-size="80" fill="#1976D2" text-anchor="middle" font-weight="bold">LEARNING</text>
  <line x1="500" y1="400" x2="1420" y2="400" stroke="#4CAF50" stroke-width="4"/>
  <circle cx="600" cy="500" r="40" fill="none" stroke="#F44336" stroke-width="4"/>
  <rect x="800" y="460" width="80" height="80" fill="none" stroke="#FF9800" stroke-width="4"/>
  
  <!-- Desks -->
  <g>
    <rect x="200" y="800" width="300" height="150" fill="#8D6E63" opacity="0.7"/>
    <rect x="600" y="800" width="300" height="150" fill="#8D6E63" opacity="0.7"/>
    <rect x="1000" y="800" width="300" height="150" fill="#8D6E63" opacity="0.7"/>
    <rect x="1400" y="800" width="300" height="150" fill="#8D6E63" opacity="0.7"/>
  </g>
  
  <!-- Floor -->
  <rect y="950" width="1920" height="130" fill="#90A4AE" opacity="0.3"/>
  
  <text x="960" y="1000" font-family="Arial, sans-serif" font-size="60" fill="#78909C" opacity="0.3" text-anchor="middle" font-weight="bold">MODERN CLASSROOM</text>
</svg>
