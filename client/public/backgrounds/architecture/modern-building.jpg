<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="archSky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1E88E5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#64B5F6;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="1920" height="1080" fill="url(#archSky)"/>
  
  <!-- Modern building (glass facade) -->
  <rect x="300" y="100" width="700" height="900" fill="#263238" opacity="0.8"/>
  
  <!-- Glass panels -->
  <g opacity="0.6">
    <rect x="320" y="120" width="150" height="200" fill="#B3E5FC"/>
    <rect x="490" y="120" width="150" height="200" fill="#81D4FA"/>
    <rect x="660" y="120" width="150" height="200" fill="#B3E5FC"/>
    <rect x="830" y="120" width="150" height="200" fill="#4FC3F7"/>
    
    <rect x="320" y="340" width="150" height="200" fill="#81D4FA"/>
    <rect x="490" y="340" width="150" height="200" fill="#B3E5FC"/>
    <rect x="660" y="340" width="150" height="200" fill="#4FC3F7"/>
    <rect x="830" y="340" width="150" height="200" fill="#81D4FA"/>
    
    <rect x="320" y="560" width="150" height="200" fill="#B3E5FC"/>
    <rect x="490" y="560" width="150" height="200" fill="#4FC3F7"/>
    <rect x="660" y="560" width="150" height="200" fill="#81D4FA"/>
    <rect x="830" y="560" width="150" height="200" fill="#B3E5FC"/>
    
    <rect x="320" y="780" width="150" height="220" fill="#4FC3F7"/>
    <rect x="490" y="780" width="150" height="220" fill="#B3E5FC"/>
    <rect x="660" y="780" width="150" height="220" fill="#81D4FA"/>
    <rect x="830" y="780" width="150" height="220" fill="#4FC3F7"/>
  </g>
  
  <!-- Second building -->
  <rect x="1050" y="250" width="600" height="750" fill="#37474F" opacity="0.7"/>
  <g opacity="0.5">
    <rect x="1080" y="280" width="130" height="180" fill="#B3E5FC"/>
    <rect x="1230" y="280" width="130" height="180" fill="#81D4FA"/>
    <rect x="1380" y="280" width="130" height="180" fill="#B3E5FC"/>
    <rect x="1530" y="280" width="100" height="180" fill="#4FC3F7"/>
  </g>
  
  <text x="960" y="950" font-family="Arial, sans-serif" font-size="70" fill="#263238" opacity="0.2" text-anchor="middle" font-weight="bold">MODERN ARCHITECTURE</text>
</svg>
