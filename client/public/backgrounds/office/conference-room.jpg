<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="wallConf" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ECEFF1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#CFD8DC;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Wall -->
  <rect width="1920" height="1080" fill="url(#wallConf)"/>
  
  <!-- Screen/TV on wall -->
  <rect x="660" y="150" width="600" height="350" fill="#212121"/>
  <rect x="680" y="170" width="560" height="310" fill="#37474F"/>
  <text x="960" y="340" font-family="Arial, sans-serif" font-size="60" fill="#78909C" text-anchor="middle">Meeting Room</text>
  
  <!-- Table edge -->
  <ellipse cx="960" cy="850" rx="800" ry="80" fill="#8D6E63"/>
  <rect x="160" y="850" width="1600" height="230" fill="#6D4C41"/>
  
  <!-- Chairs -->
  <ellipse cx="400" cy="780" rx="100" ry="40" fill="#424242" opacity="0.7"/>
  <ellipse cx="700" cy="780" rx="100" ry="40" fill="#424242" opacity="0.7"/>
  <ellipse cx="1220" cy="780" rx="100" ry="40" fill="#424242" opacity="0.7"/>
  <ellipse cx="1520" cy="780" rx="100" ry="40" fill="#424242" opacity="0.7"/>
  
  <!-- Windows on side -->
  <rect x="0" y="200" width="150" height="400" fill="#90CAF9" opacity="0.6"/>
  <rect x="1770" y="200" width="150" height="400" fill="#90CAF9" opacity="0.6"/>
  
  <text x="960" y="950" font-family="Arial, sans-serif" font-size="60" fill="#90A4AE" opacity="0.3" text-anchor="middle" font-weight="bold">CONFERENCE ROOM</text>
</svg>
