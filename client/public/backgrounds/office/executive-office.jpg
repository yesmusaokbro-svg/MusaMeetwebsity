<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="wallGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3E2723;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5D4037;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="woodGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#8D6E63;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6D4C41;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Wall -->
  <rect width="1920" height="1080" fill="url(#wallGrad)"/>
  
  <!-- Bookshelf outline -->
  <rect x="100" y="100" width="700" height="600" fill="#4E342E" opacity="0.8"/>
  <line x1="100" y1="300" x2="800" y2="300" stroke="#3E2723" stroke-width="8"/>
  <line x1="100" y1="500" x2="800" y2="500" stroke="#3E2723" stroke-width="8"/>
  <line x1="350" y1="100" x2="350" y2="700" stroke="#3E2723" stroke-width="8"/>
  <line x1="550" y1="100" x2="550" y2="700" stroke="#3E2723" stroke-width="8"/>
  
  <!-- Books -->
  <rect x="120" y="120" width="30" height="160" fill="#C62828"/>
  <rect x="160" y="120" width="25" height="160" fill="#1565C0"/>
  <rect x="195" y="120" width="35" height="160" fill="#2E7D32"/>
  <rect x="240" y="120" width="28" height="160" fill="#F57C00"/>
  <rect x="278" y="120" width="32" height="160" fill="#6A1B9A"/>
  
  <!-- Desk -->
  <rect x="0" y="750" width="1920" height="330" fill="url(#woodGrad)"/>
  <ellipse cx="960" cy="750" rx="900" ry="50" fill="#6D4C41"/>
  
  <!-- Chair suggestion -->
  <ellipse cx="960" cy="650" rx="180" ry="80" fill="#424242" opacity="0.6"/>
  
  <!-- Lamp -->
  <rect x="1600" y="550" width="20" height="200" fill="#424242"/>
  <polygon points="1520,550 1700,550 1650,450" fill="#FDD835" opacity="0.7"/>
  
  <!-- Warm lighting overlay -->
  <rect x="0" y="0" width="1920" height="1080" fill="#FFA726" opacity="0.08"/>
  
  <text x="960" y="950" font-family="Arial, sans-serif" font-size="70" fill="#8D6E63" opacity="0.2" text-anchor="middle" font-weight="bold">EXECUTIVE OFFICE</text>
</svg>
