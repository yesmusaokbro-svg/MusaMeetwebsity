<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <radialGradient id="space">
      <stop offset="0%" style="stop-color:#1A237E;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#000000;stop-opacity:1" />
    </radialGradient>
  </defs>
  
  <!-- Deep space -->
  <rect width="1920" height="1080" fill="url(#space)"/>
  
  <!-- Stars -->
  <circle cx="200" cy="150" r="2" fill="#FFFFFF"/>
  <circle cx="400" cy="300" r="3" fill="#FFFFFF"/>
  <circle cx="800" cy="200" r="2" fill="#E3F2FD"/>
  <circle cx="1200" cy="400" r="2" fill="#FFFFFF"/>
  <circle cx="1500" cy="250" r="3" fill="#E3F2FD"/>
  <circle cx="300" cy="600" r="2" fill="#FFFFFF"/>
  <circle cx="700" cy="700" r="2" fill="#FFFFFF"/>
  <circle cx="1400" cy="650" r="3" fill="#E3F2FD"/>
  <circle cx="1700" cy="800" r="2" fill="#FFFFFF"/>
  <circle cx="500" cy="900" r="2" fill="#FFFFFF"/>
  
  <!-- Planet -->
  <circle cx="1400" cy="300" r="180" fill="#536DFE" opacity="0.8"/>
  <circle cx="1400" cy="300" r="180" fill="url(#space)" opacity="0.3"/>
  <ellipse cx="1400" cy="300" rx="280" ry="40" fill="none" stroke="#7986CB" stroke-width="8" opacity="0.6"/>
  
  <!-- Distant galaxy -->
  <ellipse cx="400" cy="400" rx="100" ry="150" fill="#9FA8DA" opacity="0.3" transform="rotate(30 400 400)"/>
  
  <!-- Space station window frame -->
  <rect x="0" y="0" width="200" height="1080" fill="#37474F" opacity="0.8"/>
  <rect x="1720" y="0" width="200" height="1080" fill="#37474F" opacity="0.8"/>
  <rect x="0" y="0" width="1920" height="150" fill="#37474F" opacity="0.8"/>
  <rect x="0" y="930" width="1920" height="150" fill="#37474F" opacity="0.8"/>
  
  <text x="960" y="950" font-family="Arial, sans-serif" font-size="70" fill="#536DFE" opacity="0.4" text-anchor="middle" font-weight="bold">SPACE STATION</text>
</svg>
